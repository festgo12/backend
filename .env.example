# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/p2n?schema=public

# ─── Auth / Security ───────────────────────────────────────────────────────
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
GIFT_CARD_ENCRYPTION_KEY=change-me
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Seed admin login (used by `npm run db:seed` / `npm run db:reset`) ─────
SEED_ADMIN_EMAIL=admin@admin.com
SEED_ADMIN_PASSWORD=Admin@12345!

# ─── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=change-me

# ─── Paystack (NGN deposits/withdrawals) ───────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_change-me
PAYSTACK_WEBHOOK_SECRET=change-me
PAYSTACK_CALLBACK_URL=http://localhost:3000/paystack/callback

# ─── SMTP ──────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
SMTP_SECURE=false
SMTP_FROM="P2N <no-reply@p2n.app>"

# ─── Firebase (push notifications) ─────────────────────────────────────────
# Either a path to the service-account JSON or the JSON itself.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=change-me

# ─── Crypto provider (local-first, Alchemy) ────────────────────────────────
# Only "alchemy" is supported.
CRYPTO_PROVIDER=alchemy
# Network for EVM contracts: sepolia (default) or mainnet.
ALCHEMY_NETWORK=sepolia

ALCHEMY_ETH_API_KEY=
ALCHEMY_ETH_WS_URL=wss://eth-sepolia.g.alchemy.com/v2/your-alchemy-key
ALCHEMY_ETH_HTTP_URL=https://eth-sepolia.g.alchemy.com/v2/your-alchemy-key
ALCHEMY_BTC_HTTP_URL=https://btc-testnet.g.alchemy.com/v2/your-alchemy-key
# Block explorer/API for BTC address scans and broadcasts.
MEMPOOL_API_URL=https://mempool.space/api

# ─── HD master seeds (derive all deposit/withdrawal addresses locally) ─────
# NEVER commit real mnemonics. Seed these from your existing Tatum mnemonics
# on first migration. The xpub variants are optional and currently unused for
# signing (private keys require the mnemonic).
HD_EVM_MASTER_MNEMONIC=
HD_BTC_MASTER_MNEMONIC=
HD_EVM_MASTER_XPUB=
HD_BTC_MASTER_XPUB=

# Optional derivation overrides (defaults shown).
HD_EVM_DERIVATION_PATH=m/44'/60'/0'/0
HD_BTC_DERIVATION_PATH=m/84'/0'/0'/0
HD_EVM_ACCOUNT=0
HD_BTC_ACCOUNT=0

# ─── Confirmation thresholds & sweeping ────────────────────────────────────
BLOCK_CONFIRMATIONS_ETH=12
BLOCK_CONFIRMATIONS_BTC=2
# Sweep accumulated platform/fee wallet funds to the master when >= this amount.
DEPOSIT_SWEEP_THRESHOLD=0

# Optional per-token contract overrides (only needed on non-default networks).
ALCHEMY_USDT_CONTRACT=
ALCHEMY_USDC_CONTRACT=
