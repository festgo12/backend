PORT=3000

DATABASE_URL="postgresql://postgres:password@localhost:5432/p2p_db?schema=public"

JWT_SECRET="your_jwt_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
JWT_EXPIRATION="3600s"
JWT_REFRESH_EXPIRATION="7d"

APP_URL="http://localhost:3000"

# ─── Crypto — Hybrid Webhook Architecture ───────────────────────────────────
# EVM (ETH/USDT/USDC): Alchemy Address Activity Webhooks (push)
# BTC: QuickNode Streams (push) + QuickNode Bitcoin JSON-RPC
# Address registration: auto-on-boot + on wallet init (no manual patching).

CRYPTO_PROVIDER=alchemy
ALCHEMY_NETWORK=sepolia            # sepolia | mainnet

# Provider API Keys
ALCHEMY_ETH_API_KEY=your_alchemy_api_key
ALCHEMY_ETH_HTTP_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_SIGNING_KEY=your_alchemy_webhook_signing_key
ALCHEMY_AUTH_TOKEN=your_alchemy_dashboard_api_token
ALCHEMY_WEBHOOK_ID=wh_alchemy_your_webhook_id

# QuickNode Bitcoin RPC + Streams
QUICKNODE_API_KEY=your_quicknode_api_key
QUICKNODE_RPC_URL=https://your-btc-testnet-endpoint.quiknode.pro/YOUR_KEY
QUICKNODE_STREAMS_ID=qn_stream_your_stream_id
QN_STREAM_SECRET=your_quicknode_streams_signing_secret
QN_STREAMS_KV_LIST=p2n_btc_addresses
QN_WEBHOOK_URL=https://your-backend.com/api/v1/webhooks/quicknode

# HD master seeds (canonical). ETH/USDT/USDC share one EVM master -BIP44 .
HD_EVM_MASTER_MNEMONIC="your twelve word mnemonic phrase goes here for evm master seed"
HD_EVM_MASTER_XPUB=xpub...
# BIP84
HD_BTC_MASTER_MNEMONIC="your twelve word mnemonic phrase goes here for btc master seed"
HD_BTC_MASTER_XPUB=zpub...

# Block confirmations required before crediting deposits / completing withdrawals
BLOCK_CONFIRMATIONS_ETH=12
BLOCK_CONFIRMATIONS_BTC=2

# Sweep a child deposit address to the master wallet once it holds >= this amount
# (0 = always sweep on the scheduled interval)
DEPOSIT_SWEEP_THRESHOLD=0

# Fees & Thresholds
USDT_WITHDRAWAL_FEE=1.0
USDC_WITHDRAWAL_FEE=1.0
ETH_WITHDRAWAL_FEE=0.0001
BTC_WITHDRAWAL_FEE=0.0001

GOOGLE_CLIENT_ID=your_google_client_id

PAYSTACK_SECRET_KEY="your_paystack_secret_key"
PAYSTACK_WEBHOOK_SECRET="your_paystack_webhook_secret"
PAYSTACK_CALLBACK_URL="https://standard.paystack.co/close"

# Gift Card Encryption (32-byte hex key for AES-256-GCM)
GIFT_CARD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Security
THROTTLE_TTL=60
THROTTLE_LIMIT=10

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_SECURE=
SMTP_FROM=p2p@gmail.com

FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID="your_firebase_project_id"
