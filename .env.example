PORT=3000

DATABASE_URL="postgresql://postgres:password@localhost:5432/p2p_db?schema=public"

JWT_SECRET="your_jwt_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
JWT_EXPIRATION="3600s"
JWT_REFRESH_EXPIRATION="7d"

APP_URL="http://localhost:3000"

# ─── Crypto — Hybrid Webhook Architecture ───────────────────────────────────
# EVM (ETH/USDT/USDC on Ethereum): Alchemy Address Activity Webhooks (push)
# BSC (USDT/USDC BEP-20):           Alchemy Address Activity Webhooks (push)
# POLYGON (USDT/USDC ERC-20):        Alchemy Address Activity Webhooks (push)
# SOLANA (USDT/USDC SPL):            Alchemy Address Activity Webhooks (push)
# TRON (USDT/USDC TRC-20):           Alchemy TRON HTTP poller (scheduled)
# BTC:                              Alchemy WebSocket subscribeAddresses (push)
# Address registration: auto-on-boot + on wallet init (no manual patching).

CRYPTO_PROVIDER=alchemy
ALCHEMY_NETWORK=sepolia            # sepolia | mainnet

# Provider API Keys
ALCHEMY_ETH_API_KEY=your_alchemy_api_key
ALCHEMY_ETH_HTTP_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_SIGNING_KEY=your_alchemy_webhook_signing_key
ALCHEMY_AUTH_TOKEN=your_alchemy_dashboard_api_token
ALCHEMY_WEBHOOK_ID=wh_alchemy_your_webhook_id

# ─── Per-chain Alchemy endpoints / webhooks ────────────────────────────────
# ALCHEMY_NETWORK flips every chain between its testnet and mainnet Alchemy
# network. Each chain uses a SEPARATE Alchemy Address Activity webhook
# (webhooks are network-scoped), keyed by ALCHEMY_<CHAIN>_WEBHOOK_ID.
#
#   Chain     Testnet network      Mainnet network
#   ETH       eth-sepolia          eth-mainnet
#   BSC       bsc-sapolia          bsc-mainnet
#   POLYGON   polygon-amoy         polygon-mainnet
#   SOLANA    solana-devnet        solana-mainnet
#   TRON      tron-shasta          tron-mainnet   (HTTP poller; no webhook)
#   BTC       btc-testnet          btc-mainnet
#
# Alchemy webhook payloads carry a `network` field (e.g. ETH_SEPOLIA,
# BSC_TESTNET, MATIC_AMOY, SOLANA_DEVNET, TRON_SHASTA and -MAINNET forms) that
# routes each inbound event to the correct chain context.
ALCHEMY_BSC_HTTP_URL=https://bsc-sapolia.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_BSC_WEBHOOK_ID=wh_alchemy_your_bsc_webhook_id
ALCHEMY_BSC_AUTH_TOKEN=your_bsc_dashboard_api_token
ALCHEMY_BSC_SIGNING_KEY=your_bsc_webhook_signing_key

ALCHEMY_POLYGON_HTTP_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_POLYGON_WEBHOOK_ID=wh_alchemy_your_polygon_webhook_id
ALCHEMY_POLYGON_AUTH_TOKEN=your_polygon_dashboard_api_token
ALCHEMY_POLYGON_SIGNING_KEY=your_polygon_webhook_signing_key

ALCHEMY_SOLANA_HTTP_URL=https://solana-devnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_SOLANA_WEBHOOK_ID=wh_alchemy_your_solana_webhook_id
ALCHEMY_SOLANA_AUTH_TOKEN=your_solana_dashboard_api_token
ALCHEMY_SOLANA_SIGNING_KEY=your_solana_webhook_signing_key

ALCHEMY_TRON_HTTP_URL=https://tron-shasta.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_TRON_AUTH_TOKEN=your_tron_dashboard_api_token

# Alchemy Bitcoin RPC + WebSocket
ALCHEMY_BTC_HTTP_URL=https://btc-testnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_BTC_WS_URL=wss://bitcoin-testnet.alchemy-blast.com/v2/YOUR_KEY

# Reconciliation (cron expression — default every 8 hours)
RECONCILIATION_CRON=0 */8 * * *

# TRON TRC-20 deposit poller schedule (cron — default every 6 hours)
TRON_POLL_CRON_SCHEDULE=0 */6 * * *

# HD master seeds (canonical). ETH/USDT/USDC share one EVM master -BIP44 .
HD_EVM_MASTER_MNEMONIC="your twelve word mnemonic phrase goes here for evm master seed"
HD_EVM_MASTER_XPUB=xpub...
# BIP84
HD_BTC_MASTER_MNEMONIC="your twelve word mnemonic phrase goes here for btc master seed"
HD_BTC_MASTER_XPUB=zpub...
# Solana Ed25519 master seed (BIP-44 m/44'/501'/0'/0'/{index})
HD_SOL_MASTER_MNEMONIC="your twelve word mnemonic phrase goes here for solana master seed"
HD_SOL_MASTER_XPUB=
# TRON BIP-44 master seed (m/44'/195'/0'/0/{index})
HD_TRON_MASTER_MNEMONIC="your twelve word mnemonic phrase goes here for tron master seed"
HD_TRON_MASTER_XPUB=

# Block confirmations required before crediting deposits / completing withdrawals
BLOCK_CONFIRMATIONS_ETH=12
BLOCK_CONFIRMATIONS_BTC=2
BLOCK_CONFIRMATIONS_BSC=15
BLOCK_CONFIRMATIONS_POLYGON=128
BLOCK_CONFIRMATIONS_SOLANA=32
BLOCK_CONFIRMATIONS_TRON=19

# Sweep a child deposit address to the master wallet once its USD-equivalent
# balance reaches this threshold. E.g. 10 = sweep when balance ≈ $10 or more
# (0 = always sweep on the scheduled interval)
DEPOSIT_SWEEP_THRESHOLD=0

# Fees & Thresholds
USDT_WITHDRAWAL_FEE=1.0
USDC_WITHDRAWAL_FEE=1.0
ETH_WITHDRAWAL_FEE=0.0001
BTC_WITHDRAWAL_FEE=0.0001

GOOGLE_CLIENT_ID=your_google_client_id

PAYSTACK_SECRET_KEY="your_paystack_secret_key"
PAYSTACK_WEBHOOK_SECRET="your_paystack_webhook_secret"
PAYSTACK_CALLBACK_URL="https://standard.paystack.co/close"

# Gift Card Encryption (32-byte hex key for AES-256-GCM)
GIFT_CARD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Security
THROTTLE_TTL=60
THROTTLE_LIMIT=10

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_SECURE=
SMTP_FROM=p2p@gmail.com

FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID="your_firebase_project_id"
